---
import '../styles/global.css';
import { faqs, featuredTiktok, onSiteExperiences, onlineCourses, retreatOptions, mentoringPrograms, membership } from '../data/site';
import type { ProgramPrice } from '../data/site';

interface Props {
  title: string;
  description?: string;
  type?: string;
}

const { title, description = 'Meditation retreat in Chiang Mai — Vipassana & mindfulness with Master Kaie at Silver Temple. Beginner-friendly, English-speaking. From $27.', type = 'website' } = Astro.props;
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const routeUrl = new URL(Astro.url.pathname, `${siteOrigin}/`);
const canonicalUrl = routeUrl.href;
const routePath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomepage = routePath === '/';
const hasFaqs = routePath === '/programs';
const breadcrumbLabels: Record<string, string> = {
  '/about': 'About',
  '/method': 'The Method',
  '/programs': 'Programs',
  '/membership': 'Membership',
  '/contact': 'Contact',
  '/booking': 'Booking',
  '/meditation-retreat-chiang-mai': 'Meditation Retreat Chiang Mai',
  '/blog/best-meditation-retreat-chiang-mai': 'Journal',
  '/privacy': 'Privacy Policy',
  '/terms': 'Terms & Conditions',
};
const breadcrumbLabel = breadcrumbLabels[routePath];
const offersForPrice = (name: string, price: { thb: string; usd: string }) => [
  {
    '@type': 'Offer',
    name,
    price: price.thb.replace('THB ', '').replaceAll(',', ''),
    priceCurrency: 'THB',
    availability: 'https://schema.org/InStock',
  },
  {
    '@type': 'Offer',
    name,
    price: price.usd.replace('USD ', '').replaceAll(',', ''),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
];
const courseOffers = [...onSiteExperiences, ...onlineCourses, ...retreatOptions].flatMap((item) => {
  const name = 'title' in item && typeof item.title === 'string'
    ? item.title
    : 'name' in item && typeof item.name === 'string'
      ? item.name
      : `${'duration' in item ? item.duration : item.dur} Retreat`;
  return offersForPrice(name, item.price as ProgramPrice);
});
const mentoringOffers = mentoringPrograms.flatMap((program) => program.pricing.map((pricing) => {
  return {
    '@type': 'Offer',
    name: `${program.name} (${pricing.label})`,
    price: pricing.usd.replace('USD ', '').replaceAll(',', ''),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  };
}));
courseOffers.push(
  ...mentoringOffers,
  { '@type': 'Offer', name: `${membership.name} (Monthly)`, price: membership.priceMonth.replace('$', ''), priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  { '@type': 'Offer', name: `${membership.name} (Yearly)`, price: membership.priceYear.replace('$', ''), priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="meditation retreat Chiang Mai, vipassana retreat Thailand, mindfulness retreat Chiang Mai, Buddhist meditation retreat Thailand, Master Kaie, 347 Awakening, Silver Temple Chiang Mai" />
    <meta name="author" content="Master Kaie" />
    <meta name="publisher" content="347 Happy Life Happy World" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#1B2D5B" />

    <!-- GEO Tags -->
    <meta name="geo.region" content="TH-50" />
    <meta name="geo.placename" content="Chiang Mai" />
    <meta name="geo.position" content="18.7787367;98.9810711" />
    <meta name="ICBM" content="18.7787367, 98.9810711" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="347 Happy Life Happy World" />
    <meta property="og:image" content="https://347awakening.com/images/silver-temple-peter-borter.webp" />
    <meta property="og:image:alt" content="Wide temple photograph used for 347 Awakening in Chiang Mai" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1351" />
    <meta property="og:image:type" content="image/webp" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Awakening meditation & life transformation retreat at Silver Temple, Chiang Mai. Guided by Master Kaie. From $27." />
    <meta name="twitter:site" content="@347_happylifehappyworld" />
    <meta name="twitter:image" content="https://347awakening.com/images/silver-temple-peter-borter.webp" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Preload LCP hero background. AVIF-only link: browsers without AVIF
         support ignore it and fetch the WebP fallback from the hero picture. -->
    {isHomepage && <link
      rel="preload"
      as="image"
      type="image/avif"
      fetchpriority="high"
      href="/images/silver-temple-peter-borter-480.avif"
      imagesrcset="/images/silver-temple-peter-borter-480.avif 480w, /images/silver-temple-peter-borter-800.avif 800w, /images/silver-temple-peter-borter-1280.avif 1280w"
      imagesizes="100vw"
    />}

    <!-- Fonts. We use Google Fonts but can't inline the CSS (it changes per
         browser). The two things we can do: (1) preconnect to gstatic only —
         googleapis connects for a tiny CSS file and doesn't need a dedicated
         handshake slot; (2) declare &display=swap so text paints in the
         system fallback while the webfont is fetching. -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      media="print" onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" />
    </noscript>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Structured Data: LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "347 Happy Life Happy World",
      "alternateName": "347 Awakening",
      "description": "Awakening meditation & life transformation experience at Silver Temple, Chiang Mai, Thailand. Vipassana, mindfulness & inner coaching with Master Kaie.",
       "url": siteOrigin,
      "telephone": "+66944265297",
      "email": "347happylifehappyworld@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Srisuphan Temple (Wat Sri Suphan), Wua Lai Road",
        "addressLocality": "Chiang Mai",
        "addressRegion": "Chiang Mai",
        "postalCode": "50100",
        "addressCountry": "TH"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.7787367,
        "longitude": 98.9810711
      },
      "hasMap": "https://www.google.com/maps/place/347+Happy+life+meditation+retreat/@18.7787367,98.9810711,17z",
      "priceRange": "$27-$3500",
      "currenciesAccepted": "THB, USD",
      "paymentAccepted": "Cash, Bank Transfer",
      "openingHours": "Mo-Su 09:00-17:00",
      "image": [
        "https://347awakening.com/images/silver-temple-peter-borter.webp"
      ],
      "sameAs": [
        "https://web.facebook.com/profile.php?id=61550271392068",
        "https://www.instagram.com/kaie_awaken",
        "https://youtube.com/@kaie347happylife",
        "https://www.tiktok.com/@347_happylifehappyworld"
      ],
      "founder": {
        "@type": "Person",
        "name": "Master Kaie",
        "jobTitle": "Meditation Master for Awakening & a Better Life"
      },
      "areaServed": [
        { "@type": "City", "name": "Chiang Mai" },
        { "@type": "Country", "name": "Thailand" }
      ],
      "knowsLanguage": ["en", "th"],
      "keywords": "meditation retreat, vipassana, awakening meditation, life transformation, mindfulness, Chiang Mai, Thailand, Silver Temple"
    })} />

     <!-- Structured Data: Course offerings (only on the programs page) -->
     {hasFaqs && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "347 Awakening — Life Transformation Experience",
      "description": "Awakening meditation retreat blending Buddhist Vipassana with inner coaching techniques for life transformation in Chiang Mai, Thailand",
      "provider": {
        "@type": "Organization",
        "name": "347 Happy Life Happy World",
       "url": siteOrigin
      },
      "coursePrerequisites": "No prior meditation experience required",
      "educationalLevel": "Beginner to Advanced",
      "inLanguage": "en",
      "locationCreated": {
        "@type": "Place",
        "name": "Silver Temple",
        "address": "Wua Lai Road, Chiang Mai, Thailand"
      },
       "offers": courseOffers
     })} />}

     <!-- Structured Data: FAQPage (generated from the same data the page renders) -->
     {hasFaqs && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a }
      }))
     })} />}

    <!-- Structured Data: Person (Master Kaie) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Master Kaie",
      "jobTitle": "Meditation Master for Awakening & a Better Life",
      "description": "Founder of 347 Happy Life Happy World. Guided over 800 international students from 38+ countries to awaken their consciousness through meditation.",
      "worksFor": {
        "@type": "Organization",
        "name": "347 Happy Life Happy World"
      },
       "url": siteOrigin,
      "sameAs": [
        "https://www.instagram.com/kaie_awaken",
        "https://www.tiktok.com/@347_happylifehappyworld"
      ]
    })} />

     <!-- Structured Data: WebSite (enables Google sitelinks search box) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "347 Awakening",
      "alternateName": "347 Happy Life Happy World",
       "url": siteOrigin,
      "inLanguage": "en",
      "publisher": { "@type": "Organization", "name": "347 Happy Life Happy World" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
           "urlTemplate": `${siteOrigin}/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Structured Data: Organization (broader than LocalBusiness; helps entity recognition) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "347 Happy Life Happy World",
      "alternateName": "347 Awakening",
       "url": siteOrigin,
      "logo": "https://347awakening.com/images/logo.webp",
      "image": "https://347awakening.com/images/silver-temple-peter-borter.webp",
      "email": "347happylifehappyworld@gmail.com",
      "telephone": "+66944265297",
      "foundingDate": "2019",
      "founder": { "@type": "Person", "name": "Master Kaie" },
      "slogan": "Awaken your mind. Transform your life. Create your happy world.",
      "contactPoint": [{
        "@type": "ContactPoint",
        "telephone": "+66944265297",
        "contactType": "customer service",
        "availableLanguage": ["English", "Thai"],
        "areaServed": "Worldwide"
      }],
      "sameAs": [
        "https://web.facebook.com/profile.php?id=61550271392068",
        "https://www.instagram.com/kaie_awaken",
        "https://youtube.com/@kaie347happylife",
        "https://www.tiktok.com/@347_happylifehappyworld"
      ]
    })} />

    <!-- Structured Data: VideoObject for featured TikTok -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": "Awakening Meditation with Master Kaie — Silver Temple, Chiang Mai",
      "description": "A glimpse into the 347 Awakening meditation experience at Silver Temple in Chiang Mai, Thailand.",
      "thumbnailUrl": "https://347awakening.com/images/silver-temple-peter-borter.webp",
      "uploadDate": "2025-01-01T00:00:00+07:00",
      "contentUrl": `https://www.tiktok.com/@${featuredTiktok.username}/video/${featuredTiktok.videoId}`,
      "embedUrl": `https://www.tiktok.com/embed/v2/${featuredTiktok.videoId}`,
      "publisher": {
        "@type": "Organization",
        "name": "347 Happy Life Happy World",
        "logo": { "@type": "ImageObject", "url": "https://347awakening.com/images/logo.webp" }
      }
    })} />

     <!-- Structured Data: BreadcrumbList (helps Google understand site hierarchy) -->
     {breadcrumbLabel && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
         { "@type": "ListItem", "position": 1, "name": "Home", "item": siteOrigin },
         { "@type": "ListItem", "position": 2, "name": breadcrumbLabel, "item": canonicalUrl }
       ]
     })} />}

    <!-- Google Analytics (loaded last in head so it never blocks critical render) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NCM8XJXS9T"></script>
        <script src="../scripts/analytics.ts"></script>
  </head>
  <body class="bg-ivory text-body antialiased font-sans">
    <!-- Skip link for keyboard / screen-reader users (WCAG 2.4.1) -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Scroll progress indicator -->
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

    <main id="main-content" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <!-- Scroll reveal observer + animations -->
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealTargets = document.querySelectorAll<HTMLElement>('.reveal, .gold-line, .lotus-draw');

      // Scroll reveal — adds .visible to .reveal, .gold-line, .lotus-draw
      if (!reduce && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        revealTargets.forEach(el => obs.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('visible'));
      }

      // Stat counter — counts up from 0 to data-target when scrolled into view
      const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
      if (counters.length) {
        const animateCount = (el: HTMLElement) => {
          const target = Number(el.dataset.target || el.textContent || 0);
          const suffix = el.dataset.suffix || '';
          if (reduce || !target) {
            el.textContent = target + suffix;
            return;
          }
          const duration = 1500;
          const start = performance.now();
          const tick = (now: number) => {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            // out-expo easing
            const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            const current = Math.round(target * eased);
            el.textContent = current + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        if (!reduce && 'IntersectionObserver' in window) {
          const cobs = new IntersectionObserver((entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                if (e.target instanceof HTMLElement) animateCount(e.target);
                cobs.unobserve(e.target);
              }
            });
          }, { threshold: 0.6 });
          counters.forEach(c => {
            // Initialize to 0 so it doesn't flash the final number before animation
            c.textContent = '0' + (c.dataset.suffix || '');
            cobs.observe(c);
          });
        } else {
          counters.forEach(animateCount);
        }

      // Scroll progress bar
      const bar = document.getElementById('scroll-progress');
      if (bar && !reduce) {
        const onScroll = () => {
          const h = document.documentElement;
          const scrolled = h.scrollTop;
          const max = h.scrollHeight - h.clientHeight;
          const pct = max > 0 ? (scrolled / max) * 100 : 0;
          bar.style.width = pct + '%';
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        }
      }
    </script>
  </body>
</html>
