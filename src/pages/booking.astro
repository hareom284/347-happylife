---
import Layout from '../layouts/Layout.astro';
import { Navbar, Footer, WhatsAppBar } from '../components/index.astro';
import { wa, email, social, waMsg, onSiteExperiences, onlineCourses, retreatOptions, mentoringPrograms } from '../data/site';
---

  <Layout title="Book Your Awakening Experience | 347 Awakening — On-Site, Online & Retreats" description="Book an on-site experience, online program, retreat, or private mentoring path with 347 Awakening. Choose your format and connect with Master Kaie.">
    <Navbar wa={wa} />

  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <div class="text-center mb-10">
        <p class="text-gold-ink font-semibold text-xs uppercase tracking-[0.2em] mb-4">Reserve Your Path</p>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-deep-blue leading-tight mb-4">
          Book Your Awakening Experience
        </h1>
        <p class="text-warm-charcoal text-lg leading-relaxed max-w-xl mx-auto">
          Choose an on-site experience, online program, or 1–3 day retreat. We will confirm the right format, date, and next steps with you.
        </p>
      </div>

      <div class="rounded-section overflow-hidden shadow-card mb-10">
        <picture>
          <source type="image/avif" srcset="/images/misty-sunrise-480.avif 480w, /images/misty-sunrise-800.avif 800w, /images/misty-sunrise-1280.avif 1280w, /images/misty-sunrise-1600.avif 1600w" sizes="(max-width: 767px) 100vw, 48rem" />
          <img src="/images/misty-sunrise-800.webp" srcset="/images/misty-sunrise-480.webp 480w, /images/misty-sunrise-800.webp 800w, /images/misty-sunrise-1280.webp 1280w, /images/misty-sunrise-1600.webp 1600w" sizes="(max-width: 767px) 100vw, 48rem" alt="Misty mountains at sunrise" width="1920" height="1281" class="w-full h-48 md:h-64 object-cover" loading="lazy" decoding="async" />
        </picture>
      </div>

      <div class="space-y-8 mb-10">
        <div>
          <h2 class="font-heading text-2xl text-deep-blue mb-3">On-Site Experiences · Chiang Mai</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {onSiteExperiences.map((item) => (
              <div class="bg-cream-dark rounded-card border border-oat-border/60 p-5"><p class="text-xs uppercase tracking-wide text-gold-ink font-semibold mb-2">{item.title}</p><p class="text-sm text-body-light">{item.dur}</p><p class="font-heading text-xl text-deep-blue">{item.price.display}</p></div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="font-heading text-2xl text-deep-blue mb-3">Online Programs</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {onlineCourses.map((item) => (
              <div class="bg-cream-dark rounded-card border border-oat-border/60 p-5"><p class="text-xs uppercase tracking-wide text-gold-ink font-semibold mb-2">{item.name}</p><p class="font-heading text-xl text-deep-blue">{item.price.display}</p></div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="font-heading text-2xl text-deep-blue mb-3">Retreats</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {retreatOptions.map((item) => (
              <div class="bg-cream-dark rounded-card border border-oat-border/60 p-5"><p class="text-xs uppercase tracking-wide text-gold-ink font-semibold mb-2">{item.duration} guided retreat</p><p class="font-heading text-xl text-deep-blue">{item.price.display}</p></div>
            ))}
          </div>
        </div>
        <div class="bg-deep-blue text-cream rounded-card p-6">
          <h2 class="font-heading text-2xl mb-2">Private Mentoring</h2>
          <p class="text-cream/75 text-sm leading-relaxed">Private mentoring is available online or in person. Current USD guidance and THB pricing are confirmed directly for your chosen format. Contact us to discuss the right programme.</p>
          <p class="text-gold-light text-sm mt-3">{mentoringPrograms.map((item) => item.name).join(' · ')}</p>
        </div>
      </div>

      <div class="bg-white rounded-card border border-soft-aura shadow-card overflow-hidden">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSekYKRZvxFQxHTrV90chNtr1u5uKjkLCzlApNsbhSYDr0HISQ/viewform?embedded=true"
          width="100%"
          height="1200"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="347 Awakening Booking Form"
          loading="lazy"
          class="w-full"
        >Loading…</iframe>
      </div>

      <p class="mt-6 text-center text-body-muted text-sm">
         Prefer to book directly? <a href={waMsg('a 347 Awakening program')} target="_blank" rel="noopener noreferrer" class="text-gold-ink hover:text-gold-ink-dark underline transition-colors">Message us on WhatsApp</a> or <a href={`mailto:${email}`} class="text-gold-ink hover:text-gold-ink-dark underline transition-colors">send an email</a>
        &middot;
        <a href="/" class="text-gold-ink hover:text-gold-ink-dark underline transition-colors">Back to homepage</a>
      </p>

    </div>
  </section>

  <Footer wa={wa} email={email} fb={social.fb} ig={social.ig} yt={social.yt} tt={social.tt} />
  <WhatsAppBar wa={wa} />

</Layout>
