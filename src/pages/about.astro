---
import Layout from '../layouts/Layout.astro';
import { Navbar, Footer, WhatsAppBar, Instructors } from '../components/index.astro';
import {
  wa, email, social,
  homeIntro, mission, problemPoints,
  threePowerfulQuestions, gpsHappiness, silverTemple,
} from '../data/site';
---

<Layout title="About 347 Awakening — Awaken Your True Self" description="Meet Master Kaie and 347 Awakening: a conscious living movement at Chiang Mai's Silver Temple guiding people from outer success to inner awakening.">
  <Navbar wa={wa} />

  <!-- Page hero -->
  <section class="bg-deep-blue text-cream py-24 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-gold-light font-semibold mb-5">About</p>
      <h1 class="font-heading text-5xl md:text-6xl font-semibold mb-6">Awaken Your True Self</h1>
      <p class="text-cream/80 text-lg leading-relaxed max-w-2xl mx-auto">{homeIntro}</p>
    </div>
  </section>

  <!-- The Problem -->
  <section class="bg-cream py-20 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-gold-ink font-semibold mb-4">The Problem</p>
        <h2 class="font-heading text-3xl md:text-4xl font-semibold text-deep-blue mb-5">Successful outside, suffering inside</h2>
        <p class="text-body-light leading-relaxed mb-4">
          Today many people are successful externally but suffering internally. 347 Awakening was created to guide people back to their true essence — not through religion, not through escape, but through conscious awakening and practical transformation.
        </p>
      </div>
      <ul class="space-y-3">
        {problemPoints.map((p) => (
          <li class="flex items-start gap-3 bg-white rounded-card border border-oat-border/60 px-5 py-4 shadow-clay">
            <span class="mt-1 w-2 h-2 rounded-full bg-gold shrink-0"></span>
            <span class="text-body">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 Powerful Questions -->
  <section class="bg-cream-dark py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-xs uppercase tracking-[0.3em] text-gold-ink font-semibold mb-4">Three Powerful Questions</p>
        <h2 class="font-heading text-3xl md:text-4xl font-semibold text-deep-blue mb-4">The foundation of an awakened life</h2>
        <p class="text-body-light leading-relaxed">Without clear answers to these three questions, life can become filled with confusion and emptiness. They are the foundation of a meaningful and awakened life.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {threePowerfulQuestions.map((q) => (
          <div class="bg-white rounded-card border border-oat-border/60 p-8 shadow-card text-center">
            <div class="w-14 h-14 rounded-full bg-royal text-white font-heading text-2xl flex items-center justify-center mx-auto mb-5">{q.n}</div>
            <h3 class="font-heading text-2xl font-semibold text-deep-blue mb-3">{q.q}</h3>
            <p class="text-body-light text-sm leading-relaxed">{q.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Silver Temple & GPS Happiness -->
  <section class="bg-cream py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
        <div class="rounded-section overflow-hidden shadow-elevated order-2 lg:order-1">
          <picture>
            <source type="image/avif" srcset="/images/silver-temple-vishal-chokkala-480.avif 480w, /images/silver-temple-vishal-chokkala-800.avif 800w, /images/silver-temple-vishal-chokkala-1280.avif 1280w" sizes="(max-width: 1023px) 100vw, 50vw" />
            <img
              src="/images/silver-temple-vishal-chokkala-800.webp"
              srcset="/images/silver-temple-vishal-chokkala-480.webp 480w, /images/silver-temple-vishal-chokkala-800.webp 800w, /images/silver-temple-vishal-chokkala-1280.webp 1280w, /images/silver-temple-vishal-chokkala-2400.webp 2400w"
              sizes="(max-width: 1023px) 100vw, 50vw"
              alt="Temple façade photograph accompanying the Silver Temple history section"
              width="800"
              height="533"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="order-1 lg:order-2">
          <p class="text-xs uppercase tracking-[0.3em] text-gold-ink font-semibold mb-4">A Symbol of Inner Awakening</p>
          <h2 class="font-heading text-3xl md:text-4xl font-semibold text-deep-blue mb-5">{silverTemple.title}</h2>
           <p class="text-body-light leading-relaxed mb-4">Wat Sri Suphan, the Silver Temple, carries more than five centuries of Lanna craftsmanship and spiritual tradition. Its silver ordination hall is a living reminder that beauty, devotion, and attention are built one small piece at a time.</p>
           <p class="text-body-light leading-relaxed mb-4">For 347 Awakening, the temple is also an image of the inner temple: the quiet, clear place within every person. We do not ask people to escape ordinary life or adopt a new identity. We create the conditions to meet the mind honestly and return to what is already awake.</p>
           <p class="text-body-light leading-relaxed">{silverTemple.body}</p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {gpsHappiness.map((g) => (
          <div class="text-center px-6">
            <div class="w-16 h-16 rounded-full bg-gold text-white font-heading text-3xl flex items-center justify-center mx-auto mb-5">{g.letter}</div>
           <h3 class="font-heading text-2xl font-semibold text-deep-blue mb-2">{g.title}</h3>
            <p class="text-body-light text-sm leading-relaxed">{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- User-provided Chiang Mai reference gallery: below the fold by design. -->
  <section class="bg-cream-dark py-20 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-xs uppercase tracking-[0.3em] text-gold-ink font-semibold mb-4">The Place We Practice</p>
        <h2 class="font-heading text-3xl md:text-4xl font-semibold text-deep-blue mb-4">A Temple of Attention</h2>
        <p class="text-body-light leading-relaxed">A closer look at the temple setting and contemplative imagery connected with the Chiang Mai experience.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <picture>
          <source type="image/avif" srcset="/images/chiang-mai-thailand-320.avif 320w, /images/chiang-mai-thailand-480.avif 480w, /images/chiang-mai-thailand-600.avif 600w" sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw" />
          <img
            src="/images/chiang-mai-thailand-480.webp"
            srcset="/images/chiang-mai-thailand-320.webp 320w, /images/chiang-mai-thailand-480.webp 480w, /images/chiang-mai-thailand-600.webp 600w, /images/chiang-mai-thailand.webp 612w"
            sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
            alt="Interior view of a silver-toned temple in Chiang Mai"
            width="480"
            height="319"
            class="w-full aspect-[4/3] object-cover rounded-card shadow-card"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <picture>
          <source type="image/avif" srcset="/images/the-silver-temple-in-chiang-mai-320.avif 320w, /images/the-silver-temple-in-chiang-mai-480.avif 480w, /images/the-silver-temple-in-chiang-mai-600.avif 600w" sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw" />
          <img
            src="/images/the-silver-temple-in-chiang-mai-480.webp"
            srcset="/images/the-silver-temple-in-chiang-mai-320.webp 320w, /images/the-silver-temple-in-chiang-mai-480.webp 480w, /images/the-silver-temple-in-chiang-mai-600.webp 600w, /images/the-silver-temple-in-chiang-mai.webp 612w"
            sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
            alt="Silver-toned temple exterior in Chiang Mai"
            width="480"
            height="320"
            class="w-full aspect-[4/3] object-cover rounded-card shadow-card"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <picture>
          <source type="image/avif" srcset="/images/wat-sri-suphan-in-chiang-mai-thailand-320.avif 320w, /images/wat-sri-suphan-in-chiang-mai-thailand-480.avif 480w, /images/wat-sri-suphan-in-chiang-mai-thailand-600.avif 600w" sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw" />
          <img
            src="/images/wat-sri-suphan-in-chiang-mai-thailand-480.webp"
            srcset="/images/wat-sri-suphan-in-chiang-mai-thailand-320.webp 320w, /images/wat-sri-suphan-in-chiang-mai-thailand-480.webp 480w, /images/wat-sri-suphan-in-chiang-mai-thailand-600.webp 600w, /images/wat-sri-suphan-in-chiang-mai-thailand.webp 612w"
            sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
            alt="Temple entrance and courtyard in Chiang Mai"
            width="480"
            height="319"
            class="w-full aspect-[4/3] object-cover rounded-card shadow-card"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <picture>
          <source type="image/avif" srcset="/images/buddha-statue-in-chiang-mai-thailand-320.avif 320w, /images/buddha-statue-in-chiang-mai-thailand-480.avif 480w, /images/buddha-statue-in-chiang-mai-thailand-600.avif 600w" sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw" />
          <img
            src="/images/buddha-statue-in-chiang-mai-thailand-480.webp"
            srcset="/images/buddha-statue-in-chiang-mai-thailand-320.webp 320w, /images/buddha-statue-in-chiang-mai-thailand-480.webp 480w, /images/buddha-statue-in-chiang-mai-thailand-600.webp 600w, /images/buddha-statue-in-chiang-mai-thailand.webp 612w"
            sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw"
            alt="Buddha statue detail supporting meditation teaching"
            width="480"
            height="320"
            class="w-full aspect-[4/3] object-cover rounded-card shadow-card"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </section>

  <Instructors />

  <!-- Mission -->
  <section class="bg-royal text-cream py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-cream/70 font-semibold mb-5">Our Mission</p>
      <p class="font-heading text-2xl md:text-3xl leading-relaxed">{mission}</p>
       <a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-gold text-white px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wide hover:bg-gold-dark transition-all mt-10">
        Begin Your Journey
      </a>
    </div>
  </section>

  <Footer wa={wa} email={email} fb={social.fb} ig={social.ig} yt={social.yt} tt={social.tt} />
  <WhatsAppBar wa={wa} />
</Layout>
