---
import Layout from '../layouts/Layout.astro';
import { Navbar, Footer, WhatsAppBar } from '../components/index.astro';
import { wa, email, social } from '../data/site';
---

<Layout title="Page Not Found | 347 Awakening" description="The page you are looking for does not exist. Return to the 347 Awakening homepage to explore meditation retreats in Chiang Mai.">
  <Navbar wa={wa} />

  <section class="bg-ivory min-h-[70vh] flex items-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center py-20">
      <p class="text-xs uppercase tracking-[0.3em] text-gold-ink font-semibold mb-6">Lost on the Path</p>
      <p class="font-heading text-8xl md:text-9xl font-bold text-deep-blue/15 leading-none mb-6" aria-hidden="true">404</p>
      <h1 class="font-heading text-4xl md:text-5xl font-semibold text-deep-blue mb-6">This Page Has Drifted Away</h1>
      <p class="text-body-light text-lg leading-relaxed max-w-xl mx-auto mb-10">
        The page you are looking for does not exist. Return to the present moment — or to our homepage.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-flex items-center justify-center bg-gold text-white px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wide hover:bg-gold-dark transition-all hover:-translate-y-0.5 hover:shadow-xl shadow-lg">
          Return Home
        </a>
        <a href="/programs" class="inline-flex items-center justify-center bg-white/20 text-deep-blue px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wide border border-oat-border hover:bg-oat-light transition-all hover:-translate-y-0.5">
          Explore Programs
        </a>
        <a href="/contact" class="inline-flex items-center justify-center bg-white/20 text-deep-blue px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wide border border-oat-border hover:bg-oat-light transition-all hover:-translate-y-0.5">
          Contact Us
        </a>
      </div>
      <p class="mt-10 text-sm text-body-muted">
        Need help? <a href={wa} target="_blank" rel="noopener noreferrer" class="text-gold-ink hover:text-gold-ink-dark underline transition-colors">Message us on WhatsApp</a>
      </p>
    </div>
  </section>

  <Footer wa={wa} email={email} fb={social.fb} ig={social.ig} yt={social.yt} tt={social.tt} />
  <WhatsAppBar wa={wa} />
</Layout>
