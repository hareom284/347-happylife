---
import Layout from '../layouts/Layout.astro';
import { Navbar, Footer, WhatsAppBar } from '../components/index.astro';
import { wa, email, social } from '../data/site';
---

<Layout title="Privacy Policy | 347 Awakening">
  <Navbar wa={wa} />
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-20 md:py-28">
    <p class="text-gold-ink font-semibold text-xs uppercase tracking-[0.2em] mb-4">Your Privacy</p>
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-deep-blue mb-8">Privacy Policy</h1>
    <div class="space-y-6 text-body leading-relaxed">
      <p>347 Happy Life Happy World respects your privacy. We collect only the information you choose to share when you contact us, request a booking, or subscribe to updates.</p>
      <p>We use that information to respond to enquiries, arrange services, and provide requested support. We do not sell personal information to third parties.</p>
      <p>To ask about your information or request its removal, email <a class="text-gold-ink underline" href={`mailto:${email}`}>{email}</a>.</p>
    </div>
  </article>
  <Footer wa={wa} email={email} fb={social.fb} ig={social.ig} yt={social.yt} tt={social.tt} />
  <WhatsAppBar wa={wa} />
</Layout>
