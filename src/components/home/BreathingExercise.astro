---
---

<section id="breathe" class="relative overflow-hidden bg-gradient-to-b from-ivory via-sky-mist/50 to-ivory py-20 md:py-28 scroll-mt-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-gold-ink font-semibold mb-4">A Moment of Stillness</p>
    <h2 class="font-heading text-4xl md:text-5xl font-semibold text-deep-blue mb-4">Take a Breath</h2>
    <p class="text-body-light leading-relaxed max-w-xl mx-auto mb-12">
      Wherever you are, you can pause. Follow the circle: inhale for four counts, hold for four, exhale for four.
    </p>

    <div class="relative w-56 h-56 md:w-64 md:h-64 mx-auto flex items-center justify-center" aria-hidden="true">
      <div class="absolute inset-0 rounded-full bg-royal/15 breathe-ring"></div>
      <div class="absolute inset-6 rounded-full bg-royal/25 breathe-ring breathe-ring-lag"></div>
      <div class="absolute inset-12 rounded-full bg-royal/40 breathe-ring breathe-ring-lag-2"></div>
      <div class="relative w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-br from-royal to-deep-blue shadow-elevated flex items-center justify-center">
        <svg class="w-10 h-10 text-cream/90" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21c-4 0-7.5-2-9-5 2-1 4-1 6 0-1.5-2.5-1.5-5.5 0-8 1.5 2.5 1.5 5.5 0 8 1.5-3 4.5-5 8-5-1 3.5-3.5 6-6 7.5M12 21c4 0 7.5-2 9-5-2-1-4-1-6 0 1.5-2.5 1.5-5.5 0-8 1.5 2.5 1.5 5.5 0 8" /></svg>
      </div>
    </div>

    <p id="breath-phase" class="font-heading text-2xl text-deep-blue mt-10 min-h-8" aria-live="polite">Find a comfortable seat and follow along.</p>
    <p class="text-body-muted text-sm mt-3">Inhale 4 · Hold 4 · Exhale 4 · Repeat</p>

    <button id="sound-toggle" type="button" aria-pressed="false" class="mt-8 inline-flex items-center gap-2.5 bg-white border border-oat-border text-deep-blue px-6 py-3 rounded-full text-sm font-semibold shadow-clay hover:shadow-card transition-all">
      <svg id="sound-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H2v6h4l5 4V5zM15.5 8.5a5 5 0 010 7M19 5a9 9 0 010 14" /></svg>
      <span id="sound-label">Play a soft tone</span>
    </button>
  </div>
</section>

<script>
  const phase = document.getElementById('breath-phase');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (phase && !reduce) {
    const phases = ['Breathe In', 'Hold', 'Breathe Out'];
    let index = 0;
    const cycle = () => {
      phase.textContent = phases[index % 3];
      index += 1;
    };
    cycle();
    setInterval(cycle, 4000);
  } else if (phase) {
    phase.textContent = 'Inhale slowly for four counts, hold for four, and exhale for four.';
  }

  // Opt-in "sound of stillness": a soft synthesized bell, gentle fade in/out.
  // No audio files, no autoplay — only starts on an explicit tap.
  const toggle = document.getElementById('sound-toggle');
  const label = document.getElementById('sound-label');
  let audioContext: AudioContext | null = null;
  let timer: number | null = null;
  let playing = false;

  const playBell = (ctx: AudioContext, when: number) => {
    const master = ctx.createGain();
    master.gain.setValueAtTime(0.0001, when);
    master.gain.exponentialRampToValueAtTime(0.12, when + 0.08);
    master.gain.exponentialRampToValueAtTime(0.0001, when + 3.2);
    master.connect(ctx.destination);

    [261.63, 329.63].forEach((freq) => {
      const osc = ctx.createOscillator();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, when);
      osc.frequency.exponentialRampToValueAtTime(freq * 0.995, when + 3);
      const g = ctx.createGain();
      g.gain.setValueAtTime(freq === 329.63 ? 0.5 : 1, when);
      osc.connect(g).connect(master);
      osc.start(when);
      osc.stop(when + 3.2);
    });
  };

  const scheduleLoop = (ctx: AudioContext) => {
    const step = 4;
    for (let i = 0; i < 4; i += 1) playBell(ctx, ctx.currentTime + 0.1 + i * step);
    timer = window.setInterval(() => playBell(ctx, ctx.currentTime + 0.1), step * 4);
  };

  toggle?.addEventListener('click', async () => {
    if (!playing) {
      audioContext = audioContext ?? new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
      if (audioContext.state === 'suspended') await audioContext.resume();
      scheduleLoop(audioContext);
      playing = true;
      toggle.setAttribute('aria-pressed', 'true');
      if (label) label.textContent = 'Pause the tone';
    } else {
      if (timer) clearInterval(timer);
      if (audioContext) await audioContext.close();
      audioContext = null;
      playing = false;
      toggle.setAttribute('aria-pressed', 'false');
      if (label) label.textContent = 'Play a soft tone';
    }
  });
</script>
