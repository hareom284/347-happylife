---
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<section id="free-meditation" class="bg-gold py-16 scroll-mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-ivory rounded-section shadow-card border border-gold-dark/30 p-8 md:p-10 flex flex-col lg:flex-row items-center gap-8">
      <!-- Copy -->
      <div class="flex items-start gap-4 lg:max-w-sm">
        <div class="w-14 h-14 rounded-full bg-royal flex items-center justify-center shrink-0">
          <svg aria-hidden="true" class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8V21M8 8h8M5 8h14v0a2 2 0 002-2 3 3 0 00-5.2-2.1L12 5 10.2 3.9A3 3 0 005 6a2 2 0 002 2z" /></svg>
        </div>
        <div>
          <h2 class="font-heading text-2xl font-semibold text-deep-blue mb-1.5">Free Meditation for Busy Leaders</h2>
          <p class="text-body-light text-sm leading-relaxed">Get instant access to a 5-minute meditation to reset your mind and nervous system.</p>
        </div>
      </div>

      <!-- Mail client form, progressively enhanced with an encoded body. -->
      <div class="w-full lg:flex-1">
        <form id="free-meditation-form" action={`mailto:${email}`} method="post" class="flex flex-col sm:flex-row gap-3 w-full">
          <div class="flex-1">
            <label for="free-name" class="block text-xs uppercase tracking-[0.15em] text-body-light font-semibold mb-2">Name</label>
            <input id="free-name" name="name" type="text" autocomplete="name" required placeholder="Your name" class="w-full min-h-12 px-4 py-3 rounded-full border border-oat-border bg-white text-body placeholder:text-body-muted focus:outline-none focus:ring-2 focus:ring-gold/40" />
          </div>
          <div class="flex-1">
            <label for="free-email" class="block text-xs uppercase tracking-[0.15em] text-body-light font-semibold mb-2">Email</label>
            <input id="free-email" name="email" type="email" autocomplete="email" required placeholder="Your email" class="w-full min-h-12 px-4 py-3 rounded-full border border-oat-border bg-white text-body placeholder:text-body-muted focus:outline-none focus:ring-2 focus:ring-gold/40" />
          </div>
          <button type="submit" class="inline-flex items-center justify-center bg-deep-blue text-white px-7 py-3 min-h-12 rounded-full text-xs font-semibold uppercase tracking-wide hover:bg-navy transition-colors whitespace-nowrap">
             Get Free Access
          </button>
        </form>
        <p class="mt-3 text-xs text-body-muted">Your email app must be configured to send the request.</p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ email }}>
  const form = document.getElementById('free-meditation-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const address = String(data.get('email') || '').trim();
    const subject = 'Free 5-minute reset meditation';
    const body = `Hello, I would like free access to the 5-minute reset meditation.\n\nName: ${name}\nEmail: ${address}`;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
