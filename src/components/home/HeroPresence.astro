---
interface Props {
  wa: string;
}

const { wa } = Astro.props;
---

<section class="hero-presence relative overflow-hidden bg-deep-blue min-h-[min(760px,calc(100svh-5rem))] flex items-center">
  <picture class="absolute inset-0">
    <source type="image/avif" srcset="/images/silver-temple-peter-borter-480.avif 480w, /images/silver-temple-peter-borter-800.avif 800w, /images/silver-temple-peter-borter-1280.avif 1280w" sizes="100vw" />
    <source media="(min-width: 768px)" srcset="/images/silver-temple-peter-borter-800.webp 800w, /images/silver-temple-peter-borter-1280.webp 1280w, /images/silver-temple-peter-borter-2400.webp 2400w" />
    <img
      src="/images/silver-temple-peter-borter-480.webp"
      srcset="/images/silver-temple-peter-borter-480.webp 480w, /images/silver-temple-peter-borter-800.webp 800w, /images/silver-temple-peter-borter-1280.webp 1280w, /images/silver-temple-peter-borter-2400.webp 2400w"
      sizes="100vw"
      alt="Wide temple photograph used for 347 Awakening in Chiang Mai"
      width="480"
      height="270"
      class="hero-kenburns h-full w-full object-cover object-[62%_center] md:object-center"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <video
    id="hero-video"
    class="hero-video absolute inset-0 h-full w-full object-cover object-[62%_center] md:object-center"
    muted
    loop
    playsinline
    preload="none"
    poster="/images/silver-temple-peter-borter-800.webp"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/images/hero-mist-pagoda.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-r from-deep-blue/95 via-deep-blue/70 to-deep-blue/25"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-deep-blue/75 via-transparent to-deep-blue/20"></div>
  <div aria-hidden="true" class="hero-mist absolute -left-1/4 top-1/4 h-72 w-3/4 rounded-full bg-white/8 blur-3xl"></div>
  <div aria-hidden="true" class="hero-mist hero-mist-lag absolute -right-1/4 top-1/2 h-64 w-2/3 rounded-full bg-cream/8 blur-3xl"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 w-full">
    <div class="max-w-2xl">
      <p class="text-xs sm:text-sm uppercase tracking-[0.35em] text-gold-light font-semibold mb-6">
        347 Awakening · Happy Life Happy World
      </p>
      <h1 class="font-heading text-5xl sm:text-6xl md:text-8xl font-semibold text-white leading-[0.98] mb-6 max-w-3xl" style="text-shadow: 0 2px 18px rgba(0,0,0,0.4);">
        Awaken Through Presence
      </h1>
      <p class="text-lg md:text-xl text-cream/90 leading-relaxed mb-10 max-w-xl" style="text-shadow: 0 1px 8px rgba(0,0,0,0.4);">
         A transformational journey to reconnect with your inner wisdom, emotional balance, purpose, and consciousness.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
         <a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-gold text-white px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wide hover:bg-gold-dark transition-all hover:-translate-y-0.5 hover:shadow-xl shadow-lg">
          Join the Journey
        </a>
         <a href="#free-meditation" class="inline-flex items-center justify-center bg-white/10 backdrop-blur-sm text-white px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wide border border-white/50 hover:bg-white/20 transition-all hover:-translate-y-0.5">
           Free Meditation
         </a>
      </div>
      <p class="mt-8 text-xs uppercase tracking-[0.25em] text-white/70">Chiang Mai · Thailand</p>
    </div>
  </div>
</section>

<script>
  // Defer the ambient video until after the page has loaded so the LCP hero
  // image wins the bandwidth race; the video then fades in over the poster.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = () => {
      video.classList.add('opacity-0');
      video.load();
      video.play().then(() => {
        video.classList.remove('opacity-0');
        video.classList.add('transition-opacity', 'duration-1000');
      }).catch(() => {});
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
